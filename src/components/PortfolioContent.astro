---
const { lang } = Astro.props;
import { useTranslations, defaultLang } from "../i18n/ui";
const t = useTranslations(lang);

const toggleLang = lang === "pt" ? "en" : "pt";
const toggleHref = `/${toggleLang}/`;
const blogHref = `https://rndm.chicovis.dev/${lang}/`;

// SEO Meta Data
const title = `Rafael Chicovis | ${t("hero.role")}`;
const description = t("hero.description");
const siteUrl = "https://chicovis.dev";
const ogImage = `${siteUrl}/og-image.jpg`;

const successMsg = t("contact.success");
const errorMsg = t("contact.error");

import portfolioItems from "../data/portfolio.json";

const shotModules = import.meta.glob(
  "/public/portfolio/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true, query: "?url", import: "default" },
);

const shotsFor = (id: string) =>
  Object.keys(shotModules)
    .filter((p) => p.includes(`/portfolio/${id}/`))
    .sort()
    .map((p) => p.replace("/public", ""));

type PortfolioItem = {
  id: string;
  type: "personal" | "client";
  company: string | null;
  year: string;
  logo: string;
  demo: string;
  repos: { label: string; url: string }[];
  tech: string[];
  name: Record<string, string>;
  tagline: Record<string, string>;
  description: Record<string, string>;
  highlights: Record<string, string[]>;
};

const portfolio = (portfolioItems as PortfolioItem[]).map((item) => ({
  ...item,
  shots: shotsFor(item.id),
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Rafael Chicovis" />
    <link rel="canonical" href={`${siteUrl}/${lang}/`} />

    <link rel="alternate" hreflang="pt" href={`${siteUrl}/pt/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${siteUrl}/${defaultLang}/`}
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/${lang}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={`${siteUrl}/${lang}/`} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      // Theme and language live in cookies shared with the blog (rndm.chicovis.dev).
      window.setSharedCookie = function (name, value) {
        var host = location.hostname;
        var shared = host === "chicovis.dev" || host.endsWith(".chicovis.dev");
        var secure = location.protocol === "https:" ? "; Secure" : "";
        if (shared) {
          // Drop a legacy host-only cookie of the same name so it cannot shadow the shared one.
          document.cookie = name + "=; Path=/; Max-Age=0; SameSite=Lax" + secure;
        }
        document.cookie =
          name + "=" + encodeURIComponent(value) +
          "; Path=/; Max-Age=31536000; SameSite=Lax" +
          (shared ? "; Domain=.chicovis.dev" : "") + secure;
      };

      (function () {
        try {
          var match = document.cookie.match(/(?:^|; )theme=(dark|light)/);
          var stored = match ? match[1] : localStorage.getItem("theme");
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>

    <meta
      name="google-site-verification"
      content="bbHTKo9D5OlC77Eq_q35Fp5X99EBExENSoekYZNB8do"
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Rafael Chicovis",
        "jobTitle": "Software Engineer",
        "url": "https://chicovis.dev",
        "sameAs": [
          "https://github.com/RafaelKC",
          "https://linkedin.com/in/rafael-chicovis"
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a
    >

    <header class="navbar">
      <div class="logo accent" aria-hidden="true">chicovis.dev</div>
      <nav aria-label="Navegação principal">
        <div class="nav-links">
          <a href="#top">{t("nav.home")}</a>
          <a href="#experience">{t("nav.experience")}</a>
          <a href="#portfolio">{t("nav.portfolio")}</a>
          <a href="#education">{t("nav.education")}</a>
          <a href="#contact">{t("nav.contact")}</a>
          <a
            href={blogHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("nav.blog.label")}
          >
            {t("nav.blog")}
            <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label={t("theme.toggle")}
        >
          <i class="ti ti-sun" aria-hidden="true"></i>
        </button>
        <a
          href={toggleHref}
          class="lang-badge"
          data-lang={toggleLang}
          aria-label={`Mudar idioma para ${toggleLang.toUpperCase()}`}
        >
          {toggleLang.toUpperCase()}
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section id="top" class="hero content-wrapper">
        <p class="mono-text">{t("hero.greeting")}</p>
        <h1 class="main-title accent">
          <img
            src="/profile.jpg"
            alt="Rafael Chicovis"
            class="name-avatar"
            width="96"
            height="96"
            loading="eager"
          />
          <span>Rafael Chicovis</span>
        </h1>
        <h2 class="sub-title">{t("hero.role")}</h2>
        <p class="description">{t("hero.description")}</p>

        <div class="tag-container">
          <span class="tag csharp">C# .NET</span>
          <span class="tag angular">Angular</span>
          <span class="tag docker">Docker</span>
          <span class="tag">Microservices</span>
          <span class="tag">Agile</span>
          <span class="tag">Clean code</span>
        </div>

        <div class="hero-actions">
          <a href="#contact" class="btn-primary">{t("hero.cta.contact")} →</a>
          <a href={t("link.cv")} download class="btn-cv">
            <i class="ti ti-download" aria-hidden="true"></i>
            {t("hero.cta.cv")}
          </a>
          <div class="hero-social-links">
            <a
              href={t("link.github")}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-link"
              aria-label={t("visitar.github")}
            >
              <i class="ti ti-brand-github" aria-hidden="true"></i>
            </a>
            <a
              href={t("link.linkedin")}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-link"
              aria-label={t("visitar.linkedin")}
            >
              <i class="ti ti-brand-linkedin" aria-hidden="true"></i>
            </a>
            <a
              href={t("link.email")}
              class="icon-link"
              aria-label={t("visitar.email")}
            >
              <i class="ti ti-mail" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </section>

      <section id="experience" class="alternate-section">
        <div class="content-wrapper">
          <h3 class="section-header">
            <span class="number">01.</span>
            <span class="title">{t("exp.title")}</span>
          </h3>
          <div class="exp-container">
            <article class="exp-card">
              <div class="exp-date">2025 — Present</div>
              <div class="exp-content">
                <h4>
                  {t("exp.gestran.role")}
                  <span class="accent">@ Gestran</span>
                </h4>
                <p>{t("exp.gestran.desc")}</p>

                <div class="points">
                  <p>• {t("exp.gestran.point.1")}</p>
                  <p>• {t("exp.gestran.point.2")}</p>
                  <p>• {t("exp.gestran.point.3")}</p>
                </div>

                <div class="tags">
                  <span>.NET Core</span>
                  <span>.NET Framework</span>
                  <span>SQL Server</span>
                  <span>MongoDB</span>
                  <span>Azure DevOps</span>
                  <span>Angular</span>
                  <span>React</span>
                </div>
              </div>
            </article>

            <article class="exp-card">
              <div class="exp-date">2021 — 2025</div>
              <div class="exp-content">
                <h4>
                  {t("exp.viasoft.role")}
                  <span class="accent">@ Viasoft Korp</span>
                </h4>
                <p>{t("exp.viasoft.desc")}</p>

                <div class="points">
                  <p>• {t("exp.viasoft.point.1")}</p>
                  <p>• {t("exp.viasoft.point.2")}</p>
                  <p>• {t("exp.viasoft.point.3")}</p>
                </div>

                <div class="tags">
                  <span>Angular</span>
                  <span>C#</span>
                  <span>PostgreSQL</span>
                  <span>SQLServer</span>
                  <span>Docker</span>
                  <span>RabbitMQ</span>
                  <span>Microservices</span>
                  <span>Jira</span>
                  <span>CI/CD</span>
                </div>
              </div>
            </article>

            <article class="exp-card">
              <div class="exp-date">2026 — Present</div>
              <div class="exp-content">
                <h4>
                  {t("exp.homelab.role")}
                </h4>
                <p>{t("exp.homelab.desc")}</p>

                <div class="points">
                  <p>• {t("exp.homelab.point.1")}</p>
                  <p>• {t("exp.homelab.point.2")}</p>
                  <p>• {t("exp.homelab.point.3")}</p>
                </div>

                <div class="tags">
                  <span>Linux (Ubuntu)</span>
                  <span>Docker & Compose</span>
                  <span>Prometheus</span>
                  <span>Grafana</span>
                  <span>Oracle Cloud (OCI)</span>
                  <span>Cloudflare Tunnels</span>
                  <span>Tailscale (VPN Mesh)</span>
                  <span>Observability</span>
                  <span>Self-Hosting</span>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="portfolio" class="alternate-section">
        <div class="content-wrapper">
          <h3 class="section-header">
            <span class="number">02.</span>
            <span class="title">{t("portfolio.title")}</span>
          </h3>
          <div class="portfolio-container">
            {
              portfolio.map((project) => (
                <article class="portfolio-card">
                  <div class="portfolio-head">
                    <img
                      src={project.logo}
                      alt={`${project.name[lang]} logo`}
                      class="portfolio-logo"
                      width="48"
                      height="48"
                      loading="lazy"
                    />
                    <div class="portfolio-heading">
                      <h4>
                        {project.name[lang]}
                        {project.company && (
                          <span class="accent"> @ {project.company}</span>
                        )}
                      </h4>
                      <div class="portfolio-meta">
                        <span class="portfolio-status">
                          {project.type === "client"
                            ? t("portfolio.status.client")
                            : t("portfolio.status.paused")}
                        </span>
                        <span class="portfolio-year">{project.year}</span>
                      </div>
                    </div>
                  </div>

                  {project.shots.length > 0 ? (
                    <div
                      class="carousel"
                      data-carousel
                      aria-roledescription="carousel"
                      aria-label={project.name[lang]}
                    >
                      <div class="carousel-track" data-carousel-track>
                        {project.shots.map((src, i) => (
                          <img
                            src={src}
                            alt={`${project.name[lang]} — ${i + 1}`}
                            class="carousel-slide"
                            loading="lazy"
                          />
                        ))}
                      </div>
                      {project.shots.length > 1 && (
                        <div class="carousel-nav">
                          <button
                            type="button"
                            class="carousel-btn"
                            data-carousel-prev
                            aria-label={t("portfolio.prev")}
                          >
                            <i class="ti ti-chevron-left" aria-hidden="true" />
                          </button>
                          <button
                            type="button"
                            class="carousel-btn"
                            data-carousel-next
                            aria-label={t("portfolio.next")}
                          >
                            <i class="ti ti-chevron-right" aria-hidden="true" />
                          </button>
                        </div>
                      )}
                    </div>
                  ) : (
                    <p class="portfolio-noshots">{t("portfolio.noShots")}</p>
                  )}

                  <p class="portfolio-tagline">{project.tagline[lang]}</p>
                  <p class="portfolio-desc">{project.description[lang]}</p>

                  <p class="portfolio-highlights-label">
                    {t("portfolio.highlights")}
                  </p>
                  <ul class="portfolio-highlights">
                    {project.highlights[lang].map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>

                  <div class="tags">
                    {project.tech.map((tech) => (
                      <span>{tech}</span>
                    ))}
                  </div>

                  {project.type === "client" && (
                    <p class="portfolio-note">{t("portfolio.proprietary")}</p>
                  )}

                  <div class="portfolio-actions">
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary"
                    >
                      {project.type === "client"
                        ? t("portfolio.caseLink")
                        : t("portfolio.demo")}{" "}
                      →
                    </a>
                    {project.repos.map((repo) => (
                      <a
                        href={repo.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-cv"
                      >
                        <i class="ti ti-brand-github" aria-hidden="true" />
                        {repo.label}
                      </a>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="education" class="alternate-section">
        <div class="content-wrapper">
          <h3 class="section-header">
            <span class="number">03.</span>
            <span class="title">{t("edu.title")}</span>
          </h3>
          <div class="grid-cards">
            <div class="card">
              <span class="date-tag accent"
                >{t("edu.puc.course")} | 2022 — 2026</span
              >
              <p><b>PUCPR - Pontifícia Universidade Católica do Paraná</b></p>
              <p>{t("edu.desc")}</p>
              <p class="date-tag" style="margin-top: 10px;">
                {t("edu.puc.date")}
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="alternate-section">
        <div class="content-wrapper">
          <h3 class="section-header">
            <span class="number">04.</span>
            <span class="title">{t("nav.contact")}</span>
          </h3>
          <div class="contact-layout">
            <div class="contact-info">
              <h4 class="white-text" style="font-size: 2rem;">
                {t("contact.title")}
              </h4>
              <p class="subtitle">{t("contact.subtitle")}</p>
              <div class="contact-social-links">
                <a
                  href={t("link.github")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="icon-link"
                  aria-label="GitHub"
                >
                  <i class="ti ti-brand-github" aria-hidden="true"></i>
                </a>
                <a
                  href={t("link.linkedin")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="icon-link"
                  aria-label="LinkedIn"
                >
                  <i class="ti ti-brand-linkedin" aria-hidden="true"></i>
                </a>
                <a href={t("link.email")} class="icon-link" aria-label="Email">
                  <i class="ti ti-mail" aria-hidden="true"></i>
                </a>
              </div>
            </div>
            <div class="form-container">
              <form
                class="contact-form"
                action="https://formspree.io/f/xpqkqkyo"
                method="POST"
              >
                <div class="form-group">
                  <label for="name">{t("contact.label.name")}</label>
                  <input type="text" id="name" name="name" required />
                </div>

                <div class="form-group">
                  <label for="email">{t("contact.label.email")}</label>
                  <input type="email" id="email" name="email" required />
                </div>

                <div class="form-group">
                  <label for="message">{t("contact.label.message")}</label>
                  <textarea id="message" name="message" rows="4" required
                  ></textarea>
                </div>

                <button type="submit" class="btn-submit">
                  {t("contact.button")}
                </button>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="main-footer">
      <p>{t("footer.location")}</p>
      <p>© 2026 Rafael Chicovis. {t("footer.rights")}</p>
    </footer>

    <script define:vars={{ successMsg, errorMsg }}>
      const form = document.querySelector(".contact-form");

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const formData = new FormData(form);

          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: formData,
              headers: {
                Accept: "application/json",
              },
            });

            if (response.ok) {
              alert(successMsg);
              form.reset();
            } else {
              alert(errorMsg);
            }
          } catch (error) {
            alert(errorMsg);
          }
        });
      }
    </script>

    <script is:inline>
      (function () {
        const toggle = document.getElementById("theme-toggle");
        if (!toggle) return;
        const icon = toggle.querySelector("i");
        const syncIcon = () => {
          const isLight =
            document.documentElement.getAttribute("data-theme") === "light";
          icon.className = isLight ? "ti ti-moon" : "ti ti-sun";
        };
        syncIcon();
        const badge = document.querySelector(".lang-badge");
        if (badge) {
          badge.addEventListener("click", () => {
            window.setSharedCookie("lang", badge.getAttribute("data-lang"));
          });
        }
        toggle.addEventListener("click", () => {
          const isLight =
            document.documentElement.getAttribute("data-theme") === "light";
          const next = isLight ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          window.setSharedCookie("theme", next);
          syncIcon();
        });
      })();
    </script>

    <script is:inline>
      (function () {
        document.querySelectorAll("[data-carousel]").forEach((carousel) => {
          const track = carousel.querySelector("[data-carousel-track]");
          const prev = carousel.querySelector("[data-carousel-prev]");
          const next = carousel.querySelector("[data-carousel-next]");
          if (!track) return;
          const step = () => {
            const slide = track.querySelector(".carousel-slide");
            return slide ? slide.getBoundingClientRect().width + 12 : track.clientWidth;
          };
          prev &&
            prev.addEventListener("click", () => {
              track.scrollBy({ left: -step(), behavior: "smooth" });
            });
          next &&
            next.addEventListener("click", () => {
              track.scrollBy({ left: step(), behavior: "smooth" });
            });
        });
      })();
    </script>
  </body>
</html>

<style>
  :root,
  :root[data-theme="dark"] {
    --bg-dark: #0a0a0a;
    --bg-light: #111111;
    --accent: #ff6b00;
    --accent-hover: #e65a00;
    --text-dim: #cbd5e1; /* Melhorado para contraste A11Y */
    --white: #f8fafc;
    --border: #262626;
    --navbar-bg: rgba(10, 10, 10, 0.95);
  }

  :root[data-theme="light"] {
    --bg-dark: #ffffff;
    --bg-light: #f4f4f5;
    --accent: #e65a00;
    --accent-hover: #cc5000;
    --text-dim: #3f3f46;
    --white: #18181b;
    --border: #d4d4d8;
    --navbar-bg: rgba(255, 255, 255, 0.95);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg-dark);
    color: var(--text-dim);
    font-family: "Inter", sans-serif;
    margin: 0;
    line-height: 1.6;
    overflow-x: hidden;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--white);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--accent);
    color: white;
    padding: 1rem;
    z-index: 2000;
    text-decoration: none;
    transition: top 0.3s;
  }
  .skip-link:focus {
    top: 0;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .content-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    position: fixed;
    top: 0;
    width: 100%;
    background: var(--navbar-bg);
    backdrop-filter: blur(12px);
    z-index: 1000;
    border-bottom: 1px solid var(--border);
  }

  .navbar nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-links {
    display: flex;
    gap: 0.8rem;
  }

  .navbar a {
    color: var(--white);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .navbar a:hover {
    color: var(--accent);
  }

  .lang-badge {
    background: var(--accent);
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 800;
